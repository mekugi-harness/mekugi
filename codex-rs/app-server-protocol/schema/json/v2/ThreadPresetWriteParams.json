{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "ComposerPreset": {
      "additionalProperties": false,
      "description": "The reusable draft stored in a numbered composer preset slot.",
      "properties": {
        "input": {
          "type": "string"
        },
        "label": {
          "description": "Empty to display the first line of the input.",
          "type": "string"
        }
      },
      "required": [
        "input",
        "label"
      ],
      "type": "object"
    }
  },
  "properties": {
    "expected": {
      "anyOf": [
        {
          "$ref": "#/definitions/ComposerPreset"
        },
        {
          "type": "null"
        }
      ],
      "description": "The slot shown to the user, or null if empty."
    },
    "preset": {
      "anyOf": [
        {
          "$ref": "#/definitions/ComposerPreset"
        },
        {
          "type": "null"
        }
      ],
      "description": "The new draft, or null to remove the slot."
    },
    "slot": {
      "format": "uint8",
      "minimum": 0.0,
      "type": "integer"
    },
    "threadId": {
      "type": "string"
    }
  },
  "required": [
    "slot",
    "threadId"
  ],
  "title": "ThreadPresetWriteParams",
  "type": "object"
}