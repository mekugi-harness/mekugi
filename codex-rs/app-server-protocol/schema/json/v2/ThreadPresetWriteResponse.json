{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ComposerPreset": {
      "additionalProperties": false,
      "description": "The reusable draft stored in a numbered composer preset slot.",
      "properties": {
        "input": {
          "type": "string"
        },
        "label": {
          "description": "Empty to display the first line of the input.",
          "type": "string"
        }
      },
      "required": [
        "input",
        "label"
      ],
      "type": "object"
    }
  },
  "properties": {
    "preset": {
      "anyOf": [
        {
          "$ref": "#/definitions/ComposerPreset"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "title": "ThreadPresetWriteResponse",
  "type": "object"
}