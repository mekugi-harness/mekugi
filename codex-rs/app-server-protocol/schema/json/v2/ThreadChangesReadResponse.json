{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ThreadChangeCallerCounts": {
      "properties": {
        "additions": {
          "format": "int64",
          "type": "integer"
        },
        "deletions": {
          "format": "int64",
          "type": "integer"
        },
        "fileCount": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "threadId": {
          "type": "string"
        }
      },
      "required": [
        "additions",
        "deletions",
        "fileCount",
        "threadId"
      ],
      "type": "object"
    },
    "ThreadChangeFileDiff": {
      "properties": {
        "absolutePath": {
          "type": "string"
        },
        "additions": {
          "format": "int64",
          "type": "integer"
        },
        "changeIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "coverageNotes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "deletions": {
          "format": "int64",
          "type": "integer"
        },
        "isBinary": {
          "type": "boolean"
        },
        "movedFrom": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string"
        },
        "scope": {
          "default": "",
          "description": "Filesystem scope of the change: \"workspace\", \"external\", or \"ephemeral\".",
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "unifiedDiff": {
          "type": "string"
        }
      },
      "required": [
        "absolutePath",
        "additions",
        "changeIds",
        "coverageNotes",
        "deletions",
        "isBinary",
        "path",
        "status",
        "unifiedDiff"
      ],
      "type": "object"
    },
    "ThreadChangeOrigin": {
      "properties": {
        "authorThreadId": {
          "description": "None for captures that were not authored by an agent, such as user shell.",
          "type": [
            "string",
            "null"
          ]
        },
        "changeId": {
          "type": "string"
        },
        "createdAt": {
          "format": "int64",
          "type": "integer"
        },
        "incomplete": {
          "type": "boolean"
        },
        "itemId": {
          "type": "string"
        },
        "paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "sequence": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "sourceKind": {
          "description": "Stable identifier for the source of the capture.",
          "type": "string"
        },
        "sourceLabel": {
          "description": "User-facing name for the capture source.",
          "type": "string"
        },
        "threadId": {
          "type": "string"
        },
        "turnId": {
          "type": "string"
        },
        "workspace": {
          "type": "string"
        }
      },
      "required": [
        "changeId",
        "createdAt",
        "incomplete",
        "itemId",
        "paths",
        "sequence",
        "sourceKind",
        "sourceLabel",
        "threadId",
        "turnId",
        "workspace"
      ],
      "type": "object"
    }
  },
  "properties": {
    "callers": {
      "items": {
        "$ref": "#/definitions/ThreadChangeCallerCounts"
      },
      "type": "array"
    },
    "changes": {
      "items": {
        "$ref": "#/definitions/ThreadChangeOrigin"
      },
      "type": "array"
    },
    "fileCount": {
      "format": "uint32",
      "minimum": 0.0,
      "type": "integer"
    },
    "files": {
      "items": {
        "$ref": "#/definitions/ThreadChangeFileDiff"
      },
      "type": "array"
    },
    "incomplete": {
      "type": "boolean"
    },
    "nextCursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "threadId": {
      "type": "string"
    },
    "totalAdditions": {
      "format": "int64",
      "type": "integer"
    },
    "totalDeletions": {
      "format": "int64",
      "type": "integer"
    },
    "workspace": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "callers",
    "changes",
    "fileCount",
    "files",
    "incomplete",
    "threadId",
    "totalAdditions",
    "totalDeletions"
  ],
  "title": "ThreadChangesReadResponse",
  "type": "object"
}