{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ComposerPreset": {
      "additionalProperties": false,
      "description": "The reusable draft stored in a numbered composer preset slot.",
      "properties": {
        "input": {
          "type": "string"
        },
        "label": {
          "description": "Empty to display the first line of the input.",
          "type": "string"
        }
      },
      "required": [
        "input",
        "label"
      ],
      "type": "object"
    }
  },
  "properties": {
    "presets": {
      "additionalProperties": {
        "$ref": "#/definitions/ComposerPreset"
      },
      "description": "Occupied slots, keyed by their number (0–9).",
      "type": "object"
    }
  },
  "required": [
    "presets"
  ],
  "title": "ThreadPresetsListResponse",
  "type": "object"
}