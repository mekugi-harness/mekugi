{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Provisional JavaScript input. This is not a completed or executed tool call.",
  "properties": {
    "callId": {
      "type": "string"
    },
    "delta": {
      "type": "string"
    },
    "offset": {
      "description": "Byte offset within the call's streamed input.",
      "format": "uint32",
      "minimum": 0.0,
      "type": "integer"
    },
    "threadId": {
      "type": "string"
    },
    "turnId": {
      "type": "string"
    }
  },
  "required": [
    "callId",
    "delta",
    "offset",
    "threadId",
    "turnId"
  ],
  "title": "CodeModeInputDeltaNotification",
  "type": "object"
}