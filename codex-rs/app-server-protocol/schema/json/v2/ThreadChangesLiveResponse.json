{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "CommandExecutionSource": {
      "enum": [
        "agent",
        "userShell",
        "unifiedExecStartup",
        "unifiedExecInteraction"
      ],
      "type": "string"
    },
    "FileUpdateChange": {
      "properties": {
        "diff": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/PatchChangeKind"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "diff",
        "kind",
        "path"
      ],
      "type": "object"
    },
    "LiveCommandChanges": {
      "properties": {
        "changes": {
          "items": {
            "$ref": "#/definitions/FileUpdateChange"
          },
          "type": "array"
        },
        "command": {
          "description": "The authored shell script, bounded for preview; not the execution wrapper.",
          "type": "string"
        },
        "itemId": {
          "type": "string"
        },
        "source": {
          "$ref": "#/definitions/CommandExecutionSource"
        },
        "threadId": {
          "type": "string"
        },
        "turnId": {
          "type": "string"
        }
      },
      "required": [
        "changes",
        "command",
        "itemId",
        "source",
        "threadId",
        "turnId"
      ],
      "type": "object"
    },
    "PatchChangeKind": {
      "oneOf": [
        {
          "properties": {
            "type": {
              "enum": [
                "add"
              ],
              "title": "AddPatchChangeKindType",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "title": "AddPatchChangeKind",
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "enum": [
                "delete"
              ],
              "title": "DeletePatchChangeKindType",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "title": "DeletePatchChangeKind",
          "type": "object"
        },
        {
          "properties": {
            "move_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "enum": [
                "update"
              ],
              "title": "UpdatePatchChangeKindType",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "title": "UpdatePatchChangeKind",
          "type": "object"
        }
      ]
    }
  },
  "properties": {
    "data": {
      "description": "The latest nonempty snapshots for currently running commands, oldest update first.",
      "items": {
        "$ref": "#/definitions/LiveCommandChanges"
      },
      "type": "array"
    }
  },
  "required": [
    "data"
  ],
  "title": "ThreadChangesLiveResponse",
  "type": "object"
}