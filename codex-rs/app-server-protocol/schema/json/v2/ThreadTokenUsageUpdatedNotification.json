{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ThreadTokenUsage": {
      "properties": {
        "costPartial": {
          "type": "boolean"
        },
        "estimatedCostUsd": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "last": {
          "$ref": "#/definitions/TokenUsageBreakdown"
        },
        "lastCompletedAt": {
          "default": null,
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "lastResponseAt": {
          "default": null,
          "description": "Unix timestamps in seconds, from the producers rather than attachment time.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "modelContextWindow": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "outputTokensPerSecond": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "roundtrips": {
          "default": null,
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "roundtripsPartial": {
          "type": "boolean"
        },
        "total": {
          "$ref": "#/definitions/TokenUsageBreakdown"
        },
        "turns": {
          "default": null,
          "description": "Number of native turns started by this thread, independent of transcript paging.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "usagePartial": {
          "description": "The counted tokens are a lower bound, not a complete provider total.",
          "type": "boolean"
        },
        "usageUnavailable": {
          "description": "No provider token counts were available; context measurements can still be present.",
          "type": "boolean"
        },
        "workDurationMs": {
          "default": null,
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "workStartedAt": {
          "default": null,
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "last",
        "total"
      ],
      "type": "object"
    },
    "TokenUsageBreakdown": {
      "properties": {
        "cacheWriteInputTokens": {
          "default": 0,
          "format": "int64",
          "type": "integer"
        },
        "cachedInputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "inputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "outputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "reasoningOutputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "totalTokens": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "cachedInputTokens",
        "inputTokens",
        "outputTokens",
        "reasoningOutputTokens",
        "totalTokens"
      ],
      "type": "object"
    }
  },
  "properties": {
    "threadId": {
      "type": "string"
    },
    "tokenUsage": {
      "$ref": "#/definitions/ThreadTokenUsage"
    },
    "turnId": {
      "type": "string"
    }
  },
  "required": [
    "threadId",
    "tokenUsage",
    "turnId"
  ],
  "title": "ThreadTokenUsageUpdatedNotification",
  "type": "object"
}