{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "CaptureCoverage": {
      "properties": {
        "diagnostics": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "diagnostics",
        "status"
      ],
      "type": "object"
    },
    "CaptureInterval": {
      "properties": {
        "changeId": {
          "type": "string"
        },
        "firstChunk": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "key": {
          "type": "string"
        },
        "lastChunk": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "legacyRecordKey": {
          "type": [
            "string",
            "null"
          ]
        },
        "recordOrder": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "changeId",
        "firstChunk",
        "key",
        "lastChunk",
        "recordOrder"
      ],
      "type": "object"
    },
    "FrozenAgentCapture": {
      "properties": {
        "actor": {
          "$ref": "#/definitions/ProgressActor"
        },
        "intervals": {
          "items": {
            "$ref": "#/definitions/CaptureInterval"
          },
          "type": "array"
        }
      },
      "required": [
        "actor",
        "intervals"
      ],
      "type": "object"
    },
    "ProgressActor": {
      "properties": {
        "taskName": {
          "type": "string"
        },
        "threadId": {
          "$ref": "#/definitions/ThreadId"
        }
      },
      "required": [
        "taskName",
        "threadId"
      ],
      "type": "object"
    },
    "ThreadId": {
      "type": "string"
    }
  },
  "properties": {
    "agents": {
      "items": {
        "$ref": "#/definitions/FrozenAgentCapture"
      },
      "type": "array"
    },
    "coverage": {
      "$ref": "#/definitions/CaptureCoverage"
    },
    "publicationRevision": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "selectionRef": {
      "type": "string"
    }
  },
  "required": [
    "agents",
    "coverage",
    "publicationRevision",
    "selectionRef"
  ],
  "title": "ProgressFreezeResponse",
  "type": "object"
}