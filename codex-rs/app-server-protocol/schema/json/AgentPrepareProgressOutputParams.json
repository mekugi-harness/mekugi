{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "CaptureCoverage": {
      "properties": {
        "diagnostics": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "diagnostics",
        "status"
      ],
      "type": "object"
    },
    "CaptureInterval": {
      "properties": {
        "changeId": {
          "type": "string"
        },
        "firstChunk": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "key": {
          "type": "string"
        },
        "lastChunk": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "legacyRecordKey": {
          "type": [
            "string",
            "null"
          ]
        },
        "recordOrder": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "changeId",
        "firstChunk",
        "key",
        "lastChunk",
        "recordOrder"
      ],
      "type": "object"
    },
    "PreparedProgressAgent": {
      "properties": {
        "actor": {
          "$ref": "#/definitions/ProgressActor"
        },
        "intervals": {
          "items": {
            "$ref": "#/definitions/CaptureInterval"
          },
          "type": "array"
        },
        "summary": {
          "$ref": "#/definitions/SummaryResult"
        }
      },
      "required": [
        "actor",
        "intervals",
        "summary"
      ],
      "type": "object"
    },
    "ProgressActor": {
      "properties": {
        "taskName": {
          "type": "string"
        },
        "threadId": {
          "$ref": "#/definitions/ThreadId"
        }
      },
      "required": [
        "taskName",
        "threadId"
      ],
      "type": "object"
    },
    "SummaryResult": {
      "oneOf": [
        {
          "properties": {
            "status": {
              "enum": [
                "available"
              ],
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "text"
          ],
          "type": "object"
        },
        {
          "properties": {
            "reason": {
              "type": "string"
            },
            "status": {
              "enum": [
                "unavailable"
              ],
              "type": "string"
            }
          },
          "required": [
            "reason",
            "status"
          ],
          "type": "object"
        }
      ]
    },
    "ThreadId": {
      "type": "string"
    }
  },
  "properties": {
    "agents": {
      "items": {
        "$ref": "#/definitions/PreparedProgressAgent"
      },
      "type": "array"
    },
    "callerThreadId": {
      "$ref": "#/definitions/ThreadId"
    },
    "coverage": {
      "$ref": "#/definitions/CaptureCoverage"
    },
    "operationId": {
      "type": "string"
    },
    "recipientContextId": {
      "type": "string"
    },
    "rootThreadId": {
      "$ref": "#/definitions/ThreadId"
    },
    "selectionRef": {
      "type": "string"
    }
  },
  "required": [
    "agents",
    "callerThreadId",
    "coverage",
    "operationId",
    "recipientContextId",
    "rootThreadId",
    "selectionRef"
  ],
  "title": "ProgressOutputRequest",
  "type": "object"
}